---
import Demo from '../components/Demo.astro';
import Features from '../components/Features.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Nav from '../components/Nav.astro';
import Orchestrator from '../components/Orchestrator.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Orbit is a desktop dashboard for running Claude Code, Codex, OpenCode, Gemini CLI, and Copilot CLI sessions side by side."
    />
    <meta property="og:title" content="Orbit" />
    <meta
      property="og:description"
      content="A cinematic desktop control room for multi-provider AI coding agents."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://orbit.jfernando.dev/og-image-v2.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://orbit.jfernando.dev/og-image-v2.png" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Orbit - AI Agent Dashboard</title>
    <script defer src="https://umami.jfernando.dev/script.js" data-website-id="6cba273b-7fa2-4d80-9d05-3daf2ef5f171"></script>
  </head>
  <body>
    <div id="loader" aria-hidden="true">
      <div class="loader-mark"></div>
    </div>
    <div id="scene-root" class="scene-root" aria-hidden="true"></div>
    <div class="page-shell">
      <Nav />
      <main>
        <Hero />
        <Demo />
        <Orchestrator />
        <Features>
          <Footer />
        </Features>
      </main>
    </div>
    <button class="back-to-top" type="button" aria-label="Back to top" data-back-to-top>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="m18 15-6-6-6 6"></path>
      </svg>
    </button>

    <script>
      import { initExperience } from '../scripts/experience.js';

      initExperience();
    </script>
  </body>
</html>
