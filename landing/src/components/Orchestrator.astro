---
const agents = [
  ['claude-code', 'orchestrator session', 'active'],
  ['codex', 'refactor provider API', 'running'],
  ['claude-code', 'write regression tests', 'waiting'],
  ['opencode', 'update release notes', 'complete'],
];

const tools = ['orbit_create_agent', 'orbit_get_status', 'orbit_send_message', 'orbit_cancel_agent'];
---

<section class="orchestrator section" id="orchestrator" data-snap-section>
  <div class="orchestrator-layout">
    <div class="orchestrator-copy">
      <p class="section-kicker" data-reveal>embedded MCP server</p>
      <h2 class="section-title" data-text-scrub>Agents can delegate work without leaving Orbit.</h2>
      <p class="section-copy" data-reveal>
        Claude Code, Codex, OpenCode, Gemini CLI, and Copilot CLI can be launched and monitored
        through standard MCP tool calls. Parent and child sessions stay connected in the same UI.
      </p>
      <div class="tool-list" data-reveal>
        {tools.map((tool) => <code>{tool}</code>)}
      </div>
    </div>

    <div class="control-map" data-reveal>
      <div class="workflow-grid">
        {agents.map(([name, task, state]) => (
          <div class="agent-card">
            <div>
              <strong>{name}</strong>
              <span>{task}</span>
            </div>
            <em class:list={[`state-${state}`]}>{state}</em>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .orchestrator-layout {
    align-items: center;
    display: grid;
    gap: 70px;
    grid-template-columns: minmax(0, 0.86fr) minmax(390px, 1fr);
  }

  .tool-list {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 220px));
    justify-content: center;
    margin-top: 30px;
    max-width: 460px;
  }

  .tool-list code {
    align-items: center;
    background: rgba(77, 163, 255, 0.08);
    border: 1px solid rgba(77, 163, 255, 0.18);
    border-radius: 8px;
    color: var(--cyan);
    display: flex;
    font-family: var(--mono);
    font-size: 11px;
    justify-content: center;
    min-height: 42px;
    padding: 0 12px;
  }

  .control-map {
    background:
      linear-gradient(135deg, rgba(241, 236, 227, 0.045), rgba(241, 236, 227, 0.015)),
      rgba(12, 13, 13, 0.72);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 34px 100px rgba(0, 0, 0, 0.36);
    display: grid;
    place-items: center;
    min-height: 486px;
    overflow: hidden;
    padding: 34px;
    position: relative;
  }

  .control-map::before {
    background-image:
      linear-gradient(rgba(241, 236, 227, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(241, 236, 227, 0.035) 1px, transparent 1px);
    background-size: 32px 32px;
    content: '';
    inset: 0;
    opacity: 0.55;
    pointer-events: none;
    position: absolute;
  }

  .workflow-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 520px;
    position: relative;
    width: 100%;
    z-index: 1;
  }

  .agent-card {
    align-items: flex-start;
    backdrop-filter: blur(16px);
    background: rgba(9, 10, 10, 0.86);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: space-between;
    min-height: 136px;
    padding: 18px;
  }

  .agent-card:first-child {
    border-color: rgba(124, 255, 158, 0.34);
    box-shadow: inset 0 1px 0 rgba(124, 255, 158, 0.12);
  }

  .agent-card strong {
    color: var(--text);
    display: block;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
  }

  .agent-card span {
    color: var(--quiet);
    display: block;
    margin-top: 3px;
  }

  .agent-card em {
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 11px;
    font-style: normal;
    padding: 6px 8px;
  }

  .state-running {
    background: var(--green-soft);
    color: var(--green);
  }

  .state-active {
    background: var(--green-soft);
    color: var(--green);
  }

  .state-waiting {
    background: var(--amber-soft);
    color: var(--amber);
  }

  .state-complete {
    background: var(--cyan-soft);
    color: var(--cyan);
  }

  @media (max-width: 960px) {
    .orchestrator-layout {
      gap: 42px;
      grid-template-columns: 1fr;
    }

    .control-map {
      min-height: 420px;
    }
  }

  @media (max-width: 560px) {
    .control-map {
      min-height: 0;
      padding: 12px;
    }

    .workflow-grid {
      gap: 8px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: none;
    }

    .agent-card {
      gap: 8px;
      min-height: 106px;
      padding: 12px;
    }

    .tool-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: none;
    }

    .tool-list code {
      font-size: 10px;
      min-height: 40px;
      padding: 0 8px;
    }
  }
</style>
