---
const features = [
  {
    accent: 'green',
    title: 'Multi-provider sessions',
    text: 'Run Claude Code, Codex, OpenCode, Gemini CLI, and Copilot CLI side by side with their own model settings.',
  },
  {
    accent: 'cyan',
    title: 'Live work surface',
    text: 'Follow streaming output, tool calls, diffs, approvals, and progress without jumping between terminals.',
  },
  {
    accent: 'amber',
    title: 'Persistent memory',
    text: 'SQLite-backed projects and sessions keep history available after restarts, with resume support for follow-ups.',
  },
  {
    accent: 'green',
    title: 'Token pressure',
    text: 'Track context window usage, rate-limit states, token counts, and estimated cost per active session.',
  },
  {
    accent: 'cyan',
    title: 'Remote ready',
    text: 'Launch local or SSH-backed work with provider-aware configuration and isolated worktree workflows.',
  },
  {
    accent: 'amber',
    title: 'Sub-agent visibility',
    text: 'Inspect delegated child sessions and native sub-agents from the dashboard instead of losing work in logs.',
  },
];
---

<section class="features section" id="features" data-snap-section>
  <div class="features-head">
    <p class="section-kicker" data-reveal>built for parallel development</p>
    <h2 class="section-title" data-text-scrub>Less terminal juggling. More control over the work.</h2>
  </div>

  <div class="feature-grid">
    {features.map((feature, index) => (
      <article class:list={['feature-card', `accent-${feature.accent}`]} data-reveal style={`--i:${index + 1}`}>
        <span class="feature-index">{String(index + 1).padStart(2, '0')}</span>
        <h3>{feature.title}</h3>
        <p>{feature.text}</p>
      </article>
    ))}
  </div>

  <slot />
</section>

<style>
  .features {
    padding-bottom: 126px;
  }

  .features-head {
    max-width: 840px;
  }

  .feature-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 46px;
  }

  .feature-card {
    background: rgba(16, 17, 17, 0.78);
    border: 1px solid var(--line);
    border-radius: 8px;
    min-height: 254px;
    overflow: hidden;
    padding: 24px;
    position: relative;
  }

  .feature-card::before {
    content: '';
    height: 2px;
    left: 24px;
    position: absolute;
    right: 24px;
    top: 0;
  }

  .feature-card.accent-green::before {
    background: var(--green);
  }

  .feature-card.accent-cyan::before {
    background: var(--cyan);
  }

  .feature-card.accent-amber::before {
    background: var(--amber);
  }

  .feature-index {
    color: var(--quiet);
    display: block;
    font-family: var(--mono);
    font-size: 12px;
    margin-bottom: 54px;
  }

  .feature-card h3 {
    color: var(--text);
    font-family: var(--display);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.04;
    margin: 0;
  }

  .feature-card p {
    color: var(--muted);
    margin: 16px 0 0;
  }

  @media (max-width: 920px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .feature-card {
      min-height: 0;
    }

    .feature-index {
      margin-bottom: 34px;
    }
  }
</style>
