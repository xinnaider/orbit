---
const links = [
  { href: '#product', label: 'Product' },
  { href: '#orchestrator', label: 'MCP' },
  { href: '#features', label: 'Features' },
  { href: 'https://github.com/xinnaider/orbit#readme', label: 'Docs' },
];
---

<nav class="nav-shell" aria-label="Primary navigation">
  <a class="brand" href="#hero" aria-label="Orbit home">
    <span class="brand-mark" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <ellipse cx="12" cy="12" rx="9" ry="3.8" stroke="currentColor" stroke-width="1.35" transform="rotate(-34 12 12)"></ellipse>
        <ellipse cx="12" cy="12" rx="7.4" ry="2.8" stroke="currentColor" stroke-width="0.9" opacity="0.34" transform="rotate(28 12 12)"></ellipse>
        <circle cx="12" cy="12" r="2.25" fill="currentColor"></circle>
      </svg>
    </span>
    <span>Orbit</span>
  </a>

  <div class="nav-links">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </div>

  <a class="nav-cta" href="https://github.com/xinnaider/orbit">
    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
    </svg>
    GitHub
  </a>
</nav>

<style>
  .nav-shell {
    align-items: center;
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr auto 1fr;
    left: 24px;
    min-height: 58px;
    pointer-events: none;
    position: fixed;
    right: 24px;
    top: 18px;
    z-index: 80;
  }

  .brand,
  .nav-cta,
  .nav-links {
    align-items: center;
    backdrop-filter: blur(20px);
    display: flex;
    pointer-events: auto;
  }

  .brand {
    background: rgba(12, 13, 13, 0.5);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text);
    font-family: var(--display);
    font-size: 18px;
    font-weight: 700;
    gap: 10px;
    letter-spacing: 0;
    padding: 9px 14px;
    width: fit-content;
  }

  .brand-mark {
    color: var(--green);
    display: grid;
    filter: drop-shadow(0 0 16px rgba(124, 255, 158, 0.24));
    place-items: center;
  }

  .nav-links {
    background: rgba(12, 13, 13, 0.46);
    border: 1px solid var(--line);
    border-radius: 999px;
    gap: 6px;
    padding: 5px;
    box-shadow: 0 18px 52px rgba(0, 0, 0, 0.2);
  }

  .nav-links a {
    border-radius: 999px;
    color: var(--muted);
    font-size: 13px;
    padding: 7px 12px;
    transition:
      background 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .nav-links a:hover {
    background: rgba(241, 236, 227, 0.06);
    color: var(--text);
  }

  .nav-cta {
    background: rgba(12, 13, 13, 0.5);
    border: 1px solid rgba(124, 255, 158, 0.32);
    border-radius: 999px;
    color: var(--green);
    gap: 8px;
    justify-self: end;
    padding: 9px 14px;
    transition:
      background 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .nav-cta:hover {
    background: rgba(124, 255, 158, 0.16);
    border-color: rgba(124, 255, 158, 0.48);
  }

  @media (max-width: 820px) {
    .nav-shell {
      grid-template-columns: 1fr auto;
      left: 14px;
      right: 14px;
      top: 12px;
    }

    .nav-links {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .nav-shell {
      padding-left: 14px;
    }

    .nav-cta {
      font-size: 13px;
      padding: 8px 11px;
    }
  }
</style>
