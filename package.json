{
  "name": "orbit",
  "version": "0.6.0",
  "description": "Orbit — multi-session Claude Code agent dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "vite dev --mode mock",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run && vitest run --config vitest.components.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "test:e2e:tauri": "playwright test --project=tauri",
    "test:watch": "vitest",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:rust": "cargo test --manifest-path tauri/Cargo.toml --lib",
    "lint": "npm run lint:ui && npm run lint:tauri",
    "lint:ui": "eslint ui --max-warnings 0 && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint:tauri": "cargo clippy --manifest-path tauri/Cargo.toml -- -D warnings",
    "format": "npm run format:ui && npm run format:tauri",
    "format:ui": "prettier --write \"ui/**/*.{ts,svelte,css}\"",
    "format:tauri": "cargo fmt --manifest-path tauri/Cargo.toml",
    "format:check": "npm run format:check:ui && npm run format:check:tauri",
    "format:check:ui": "prettier --check \"ui/**/*.{ts,svelte,css}\"",
    "format:check:tauri": "cargo fmt --manifest-path tauri/Cargo.toml --check",
    "tauri": "tauri",
    "ensure:sidecar": "node scripts/ensure-sidecar.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "clean": "node scripts/clean-artifacts.mjs",
    "clean:all": "node scripts/clean-artifacts.mjs --all",
    "clean:rust": "cargo clean --manifest-path tauri/Cargo.toml",
    "tauri:dev": "node scripts/ensure-sidecar.mjs && npx tauri dev --config tauri/tauri.conf.json",
    "tauri:build": "node scripts/build-sidecar.mjs --release && npx tauri build --config tauri/tauri.conf.json",
    "tauri:icon": "npx tauri icon --config tauri/tauri.conf.json",
    "demo:gif": "node scripts/generate-demo-gif.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.4",
    "highlight.js": "^11.11.1",
    "lucide-svelte": "^1.0.1",
    "marked": "^17.0.5",
    "monaco-editor": "^0.55.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.2.7",
    "@types/diff": "^7.0.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.46.0",
    "gifenc": "^1.0.3",
    "globals": "^15.0.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "puppeteer": "^24.40.0",
    "sharp": "^0.34.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^0.43.0",
    "to-ico": "^1.1.5",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^2.0.0"
  }
}
